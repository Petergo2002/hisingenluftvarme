---
import Container from './Container.astro';
import { SITE } from '../data/site';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const serviceLinks = [
  { href: '/installation-luftvarmepump', label: 'Installation' },
  { href: '/service-luftvarmepump', label: 'Service & underhåll' },
  { href: '/felsokning-luftvarmepump', label: 'Felsökning' },
];
const isCurrent = (href: string) => currentPath === href;
const isServicePage = serviceLinks.some(({ href }) => isCurrent(href));
---

<header class="header">
  <Container>
    <div class="header-inner">
      <a href="/" class="logo" aria-label={`${SITE.name} startsida`}>
        <img src="/hisingen_luftv%C3%A4rme_logo%20-%20Sebastian%20Fihn.png" alt={SITE.name} />
      </a>

      <nav class="desktop-nav" aria-label="Huvudnavigation">
        <ul class="nav-links">
          <li><a href="/" aria-current={isCurrent('/') ? 'page' : undefined}>Start</a></li>
          <li><a href="/produkter" aria-current={isCurrent('/produkter') ? 'page' : undefined}>Produkter</a></li>
          <li><a href="/luftvarmepump-pris" aria-current={isCurrent('/luftvarmepump-pris') ? 'page' : undefined}>Priser</a></li>
          <li class="nav-dropdown">
            <details data-nav-dropdown>
              <summary class:list={{ active: isServicePage }}>
                Tjänster
                <svg viewBox="0 0 12 8" aria-hidden="true">
                  <path d="m1 1.5 5 5 5-5"></path>
                </svg>
              </summary>
              <div class="dropdown-panel">
                <span class="dropdown-label">Våra tjänster</span>
                <ul>
                  {serviceLinks.map(({ href, label }) => (
                    <li>
                      <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
                        <span>{label}</span>
                        <svg viewBox="0 0 16 16" aria-hidden="true">
                          <path d="M3 8h10M9 4l4 4-4 4"></path>
                        </svg>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </details>
          </li>
          <li><a href="/projekt" aria-current={isCurrent('/projekt') ? 'page' : undefined}>Projekt</a></li>
        </ul>
      </nav>

      <div class="desktop-actions">
        <a href={SITE.phoneHref} class="nav-link-simple">{SITE.phoneDisplay}</a>
        <a href="/offert" class="btn btn-primary" aria-current={isCurrent('/offert') ? 'page' : undefined}>Begär offert</a>
      </div>

      <details class="mobile-nav">
        <summary class="menu-toggle" aria-label="Öppna meny">
          <svg class="icon-menu" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
          <svg class="icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </summary>

        <div class="mobile-menu">
          <a href={SITE.phoneHref} class="mobile-phone">{SITE.phoneDisplay}</a>

          <ul class="mobile-nav-links">
            <li><a href="/" aria-current={isCurrent('/') ? 'page' : undefined}>Start</a></li>
            <li><a href="/produkter" aria-current={isCurrent('/produkter') ? 'page' : undefined}>Produkter</a></li>
            <li><a href="/luftvarmepump-pris" aria-current={isCurrent('/luftvarmepump-pris') ? 'page' : undefined}>Priser</a></li>
            <li>
              <details class="mobile-services" open={isServicePage}>
                <summary class:list={{ active: isServicePage }}>
                  Tjänster
                  <svg viewBox="0 0 12 8" aria-hidden="true">
                    <path d="m1 1.5 5 5 5-5"></path>
                  </svg>
                </summary>
                <ul>
                  {serviceLinks.map(({ href, label }) => (
                    <li><a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a></li>
                  ))}
                </ul>
              </details>
            </li>
            <li><a href="/projekt" aria-current={isCurrent('/projekt') ? 'page' : undefined}>Projekt</a></li>
          </ul>

          <a href="/offert" class="btn btn-primary mobile-cta">Begär offert</a>
        </div>
      </details>
    </div>
  </Container>
</header>

<style>
  .header {
    background: rgba(255, 255, 255, 0.94);
    border-bottom: 1px solid var(--border-warm);
    box-shadow: 0 10px 30px rgba(20, 20, 20, 0.06);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    position: sticky;
    top: 0;
    z-index: 100;
    padding: 1rem 0;
  }

  .header-inner {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1.5rem;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
  }

  .logo img {
    display: block;
    width: auto;
    height: 62px;
    object-fit: contain;
  }

  .desktop-nav {
    justify-self: center;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .nav-links a,
  .nav-dropdown summary,
  .mobile-nav-links > li > a,
  .mobile-services > summary {
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--secondary);
    transition: color 0.2s ease;
  }

  .nav-links a:hover,
  .nav-dropdown summary:hover,
  .mobile-nav-links a:hover,
  .mobile-services > summary:hover {
    color: var(--secondary-hover);
  }

  .nav-links a[aria-current='page'],
  .nav-dropdown summary.active,
  .mobile-nav-links a[aria-current='page'],
  .mobile-services > summary.active {
    color: var(--secondary-hover);
  }

  .nav-dropdown {
    position: relative;
  }

  .nav-dropdown details {
    position: relative;
  }

  .nav-dropdown summary,
  .mobile-services > summary {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    cursor: pointer;
    user-select: none;
  }

  .nav-dropdown summary::-webkit-details-marker,
  .mobile-services > summary::-webkit-details-marker {
    display: none;
  }

  .nav-dropdown summary svg,
  .mobile-services > summary svg {
    width: 10px;
    height: 7px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
    transition: transform 0.2s ease;
  }

  .nav-dropdown details[open] > summary svg,
  .mobile-services[open] > summary svg {
    transform: rotate(180deg);
  }

  .dropdown-panel {
    position: absolute;
    top: calc(100% + 1.25rem);
    left: 50%;
    width: 17rem;
    padding: 0.75rem;
    background: rgba(255, 255, 255, 0.98);
    border: 1px solid var(--border-warm);
    border-radius: 10px;
    box-shadow: 0 24px 60px rgba(20, 20, 20, 0.15);
    transform: translateX(-50%);
  }

  .dropdown-panel::before {
    position: absolute;
    top: -1.3rem;
    left: 0;
    width: 100%;
    height: 1.3rem;
    content: '';
  }

  .dropdown-label {
    display: block;
    padding: 0.35rem 0.65rem 0.6rem;
    color: var(--text-muted);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .dropdown-panel ul {
    display: grid;
    gap: 0.2rem;
  }

  .dropdown-panel a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 44px;
    padding: 0.75rem;
    border-radius: 6px;
    text-transform: none;
    letter-spacing: 0;
  }

  .dropdown-panel a:hover,
  .dropdown-panel a[aria-current='page'] {
    background: var(--secondary-soft);
  }

  .dropdown-panel a svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .dropdown-panel a:hover svg,
  .dropdown-panel a[aria-current='page'] svg {
    opacity: 1;
    transform: translateX(0);
  }

  .desktop-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .nav-link-simple {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--secondary);
    white-space: nowrap;
  }

  .nav-link-simple:hover {
    color: var(--secondary-hover);
  }

  .nav-links a:focus-visible,
  .nav-dropdown summary:focus-visible,
  .nav-link-simple:focus-visible,
  .menu-toggle:focus-visible,
  .mobile-nav-links a:focus-visible,
  .mobile-services > summary:focus-visible {
    outline: 2px solid var(--secondary);
    outline-offset: 4px;
  }

  .desktop-actions :global(.btn-primary),
  .mobile-cta {
    background: var(--secondary);
    border-color: var(--secondary);
    color: var(--white);
  }

  .desktop-actions :global(.btn-primary:hover),
  .mobile-cta:hover {
    background: var(--secondary-hover);
    border-color: var(--secondary-hover);
    color: var(--white);
  }

  .mobile-nav {
    display: none;
  }

  .menu-toggle {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--border-warm);
    border-radius: 6px;
    color: var(--secondary);
    cursor: pointer;
    background: var(--secondary-soft);
  }

  .menu-toggle::-webkit-details-marker {
    display: none;
  }

  .menu-toggle svg {
    width: 22px;
    height: 22px;
  }

  .icon-close {
    display: none;
  }

  .mobile-nav[open] .icon-menu {
    display: none;
  }

  .mobile-nav[open] .icon-close {
    display: block;
  }

  .mobile-menu {
    position: absolute;
    top: calc(100% + 0.75rem);
    right: 0;
    width: min(20rem, calc(100vw - 3rem));
    padding: 1rem;
    background: rgba(255, 255, 255, 0.98);
    border: 1px solid var(--border-warm);
    border-radius: 8px;
    box-shadow: 0 24px 60px rgba(20, 20, 20, 0.16);
  }

  .mobile-phone {
    display: block;
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-warm);
    color: var(--secondary);
    font-weight: 700;
  }

  .mobile-nav-links {
    display: grid;
    gap: 0.25rem;
  }

  .mobile-nav-links > li > a,
  .mobile-services > summary {
    min-height: 44px;
    padding: 0.75rem 0.25rem;
  }

  .mobile-services ul {
    display: grid;
    gap: 0.15rem;
    margin: 0.1rem 0 0.65rem;
    padding-left: 0.75rem;
    border-left: 2px solid var(--border-warm);
  }

  .mobile-services li a {
    display: flex;
    align-items: center;
    min-height: 42px;
    padding: 0.55rem 0.75rem;
    border-radius: 6px;
    color: var(--text-muted);
    font-size: 0.95rem;
    font-weight: 650;
  }

  .mobile-services li a:hover,
  .mobile-services li a[aria-current='page'] {
    background: var(--secondary-soft);
    color: var(--secondary);
  }

  .mobile-cta {
    width: 100%;
    margin-top: 1.25rem;
  }

  @media (max-width: 900px) {
    .header-inner {
      grid-template-columns: auto 1fr auto;
    }

    .desktop-nav,
    .desktop-actions {
      display: none;
    }

    .mobile-nav {
      display: block;
      justify-self: end;
    }
  }

  @media (max-width: 640px) {
    .header {
      padding: 0.75rem 0;
    }

    .logo img {
      height: 50px;
    }
  }
</style>

<script>
  const navDropdowns = document.querySelectorAll<HTMLDetailsElement>('details[data-nav-dropdown]');

  document.addEventListener('click', (event) => {
    navDropdowns.forEach((dropdown) => {
      if (dropdown.open && !dropdown.contains(event.target as Node)) {
        dropdown.removeAttribute('open');
      }
    });
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;

    navDropdowns.forEach((dropdown) => {
      if (!dropdown.open) return;

      dropdown.removeAttribute('open');
      dropdown.querySelector('summary')?.focus();
    });
  });
</script>
