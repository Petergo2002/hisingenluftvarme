---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTASection from '../components/CTASection.astro';
import FAQSection from '../components/FAQSection.astro';
import { AREA_LINKS, PRODUCTS, SERVICE_AREA_SCHEMA, SITE } from '../data/site';

const title = "Luftvärmepumpar med installation | Priser efter ROT";
const description = "Jämför luftvärmepumpar med pris efter ROT-avdrag och standardinstallation i Göteborg, Stenungsund och Lilla Edet. Få hjälp att välja rätt modell.";
const choiceGuides = [
  {
    title: "Boyta och planlösning",
    text: "Vi tittar på hur stor yta som ska värmas, hur öppen planlösningen är och var luften behöver spridas för att pumpen ska göra verklig nytta.",
  },
  {
    title: "Ljud, placering och utedel",
    text: "Rätt placering påverkar både komfort, ljudnivå, kondensvatten, serviceåtkomst och hur prydlig installationen blir på fasaden.",
  },
  {
    title: "Pris efter ROT-avdrag",
    text: "Produktpriserna visas efter ROT-avdrag och inklusive standardinstallation. Vid hembesök går vi igenom om tillägg behövs.",
  },
];
const productFaqs = [
  {
    question: "Ingår installation i produktpriserna?",
    answer: "Ja, priserna på produktsidan visas efter ROT-avdrag och inklusive standardinstallation. Eventuella tillägg beror på installationsförutsättningarna.",
  },
  {
    question: "Vilken luftvärmepump passar mitt hus?",
    answer: "Det beror på boyta, planlösning, isolering, placering, ljudkrav och hur pumpen ska användas. Vi hjälper dig jämföra modeller vid hembesök eller offertförfrågan.",
  },
  {
    question: "Kan jag få hjälp i Göteborg, Stenungsund eller Lilla Edet?",
    answer: "Ja, Hisingen Luftvärme prioriterar Göteborg, Stenungsund och Lilla Edet för rådgivning, installation, service och felsökning.",
  },
];
const productListSchema = {
  "@type": "ItemList",
  name: "Luftvärmepumpar med installation",
  itemListElement: PRODUCTS.map((product, index) => ({
    "@type": "ListItem",
    position: index + 1,
    item: {
      "@type": "Product",
      "@id": `${new URL("/produkter", SITE.url).toString()}#${product.name.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`,
      name: product.name,
      description: product.specs.join(", "),
      category: "Luftvärmepump",
      image: product.image ? new URL(product.image, SITE.url).toString() : undefined,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
      offers: {
        "@type": "Offer",
        price: product.price.replace(/\D/g, ""),
        priceCurrency: "SEK",
        availability: "https://schema.org/InStock",
        url: new URL("/produkter", SITE.url).toString(),
        areaServed: SERVICE_AREA_SCHEMA,
        seller: {
          "@id": `${SITE.url}/#business`,
        },
      },
    },
  })),
};
---

<BaseLayout title={title} description={description} image="/images/service-installation.jpg" structuredData={productListSchema}>
  <Breadcrumbs crumbs={[{ text: "Produkter" }]} />

  <section class="section-padding bg-light">
    <Container>
      <div class="section-header text-center">
        <span class="eyebrow">Produkter</span>
        <h1>Luftvärmepumpar med installation</h1>
        <p class="text-muted">Alla priser visas efter ROT-avdrag och inklusive standardinstallation i Göteborg, Stenungsund och Lilla Edet.</p>
      </div>

      <div class="products-grid">
        {PRODUCTS.map((product) => (
          <article class="surface product-card">
            {product.image && (
              <img
                src={product.image}
                alt={product.imageAlt ?? product.name}
                class="product-image"
                loading="lazy"
                decoding="async"
              />
            )}
            <div>
              <h2>{product.name}</h2>
              <p class="price">{product.price}</p>
              <p class="price-note">Pris efter ROT-avdrag, inklusive standardinstallation.</p>
            </div>
            <ul>
              {product.specs.map((spec) => <li>{spec}</li>)}
            </ul>
            {product.productSheet && (
              <a href={product.productSheet} class="product-sheet" target="_blank" rel="noopener noreferrer">
                Produktblad
              </a>
            )}
          </article>
        ))}
      </div>
    </Container>
  </section>

  <section class="section-padding">
    <Container>
      <div class="section-header narrow">
        <span class="eyebrow">Modellval</span>
        <h2>Välj pump efter huset, inte bara priset</h2>
        <p class="text-muted">En luftvärmepump ska passa bostaden, placeringen och hur du använder värme och kyla i vardagen.</p>
      </div>
      <div class="guide-grid">
        {choiceGuides.map((guide) => (
          <article class="guide-card">
            <h3>{guide.title}</h3>
            <p>{guide.text}</p>
          </article>
        ))}
      </div>
      <div class="link-strip" aria-label="Fortsätt läsa">
        <a href="/luftvarmepump-pris">Se prisguide och ROT</a>
        <a href="/installation-luftvarmepump">Läs om installation</a>
        {AREA_LINKS.map((area) => <a href={area.link}>Luftvärmepump i {area.name}</a>)}
      </div>
    </Container>
  </section>

  <FAQSection faqs={productFaqs} />

  <CTASection
    title="Osäker på vilken modell som passar?"
    description="Vi gör kostnadsfria hembesök i Göteborg, Stenungsund och Lilla Edet och hjälper dig att hitta den bästa lösningen för ditt hus."
    buttonText="Boka hembesök"
    buttonLink="/offert"
  />
</BaseLayout>

<style>
  .bg-light {
    background: var(--bg-subtle);
  }
  .section-header {
    margin-bottom: 4rem;
  }
  .section-header.narrow {
    max-width: 760px;
    margin-bottom: 2rem;
  }
  .text-center {
    text-align: center;
  }
  .section-header h1,
  .product-card h2,
  .product-card li,
  .price-note {
    overflow-wrap: anywhere;
  }
  .section-header h1 {
    overflow-wrap: normal;
    word-break: normal;
    hyphens: auto;
  }
  .section-header p {
    overflow-wrap: anywhere;
  }
  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 1.5rem;
    align-items: stretch;
  }
  .product-card {
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    min-width: 0;
  }
  .product-card > div,
  .product-card > ul,
  .product-sheet {
    margin-left: 2rem;
    margin-right: 2rem;
  }
  .product-card > div:first-child {
    margin-top: 2rem;
  }
  .product-image {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: contain;
    padding: 1rem;
    background: #fff;
  }
  .product-card h2 {
    font-size: 1.35rem;
    margin-bottom: 1rem;
  }
  .price {
    color: var(--secondary-hover);
    font-size: 1.6rem;
    font-weight: 900;
    margin-bottom: 0.25rem;
  }
  .price-note {
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .product-card ul {
    list-style: disc;
    padding-left: 1.2rem;
  }
  .product-card li {
    color: var(--text-muted);
    margin-bottom: 0.6rem;
    line-height: 1.5;
  }
  .product-sheet {
    margin-top: auto;
    margin-bottom: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    color: var(--secondary-hover);
    font-size: 0.875rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .product-sheet:hover {
    color: var(--secondary);
  }
  .guide-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .guide-card {
    padding: 2rem;
    border: 1px solid var(--border);
    background: var(--white);
  }
  .guide-card h3 {
    font-size: 1.15rem;
    margin-bottom: 0.8rem;
  }
  .guide-card p {
    color: var(--text-muted);
    line-height: 1.7;
  }
  .link-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .link-strip a {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0.5rem 0.85rem;
    border: 1px solid var(--border-warm);
    border-radius: 999px;
    color: var(--secondary);
    background: var(--secondary-soft);
    font-size: 0.9rem;
    font-weight: 800;
  }
  .link-strip a:hover {
    color: var(--secondary-hover);
  }

  @media (max-width: 640px) {
    .section-header {
      margin-bottom: 2.5rem;
    }

    .section-header h1 {
      font-size: clamp(1.75rem, 8vw, 2.25rem);
      line-height: 1.15;
    }

    .products-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .product-card {
      gap: 1.25rem;
    }
    .product-card > div,
    .product-card > ul,
    .product-sheet {
      margin-left: 1.5rem;
      margin-right: 1.5rem;
    }
    .product-card > div:first-child {
      margin-top: 1.5rem;
    }

    .product-card h2 {
      font-size: 1.2rem;
      margin-bottom: 0.75rem;
    }

    .price {
      font-size: 1.45rem;
    }
    .product-sheet {
      margin-bottom: 1.5rem;
    }
  }

  @media (max-width: 820px) {
    .guide-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
