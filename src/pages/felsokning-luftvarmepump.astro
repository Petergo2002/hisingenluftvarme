---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import Container from '../components/Container.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import AreaCard from '../components/AreaCard.astro';
import ServiceCard from '../components/ServiceCard.astro';
import FAQSection from '../components/FAQSection.astro';
import CTASection from '../components/CTASection.astro';
import { AREA_LINKS, SERVICE_AREA_SCHEMA, SITE } from '../data/site';

const serviceName = "Problem med luftvärmepump";
const title = "Felsökning luftvärmepump Göteborg | Felkod & dålig värme";
const description = "Felsökning av luftvärmepump på Hisingen, i Göteborg, Stenungsund och Lilla Edet vid felkod, missljud, sämre värme, sämre kyla eller konstig drift.";

const areas = AREA_LINKS;

const otherServices = [
  {
    title: "Hembesök",
    description: "Vi utför kostnadsfria hembesök på Hisingen, i Göteborg, Stenungsund och Lilla Edet för att hitta bästa lösningen för ditt hus.",
    link: "/offert",
    image: "/images/hero.png",
    imageAlt: "Hembesök inför val av luftvärmepump"
  },
  {
    title: "Installation av luftvärmepump",
    description: "Standardinstallationen täcker de flesta installationer, men extra rör, kabel eller tillägg kan behövas.",
    link: "/installation-luftvarmepump",
    image: "/images/service-installation.jpg",
    imageAlt: "Installation av luftvärmepump i villa"
  },
  {
    title: "Service av luftvärmepump",
    description: "En luftvärmepump bör servas med 2–3 års intervall för att säkerställa god effekt.",
    link: "/service-luftvarmepump",
    image: "/images/service-maintenance.png",
    imageAlt: "Professionell service av luftvärmepump"
  }
];

const troubleshootingChecks = [
  {
    title: "Felkod i displayen",
    text: "Skriv gärna ner felkoden och när den visas. Det gör det lättare att bedöma om felet kan lösas med kontroll, service eller vidare åtgärd.",
  },
  {
    title: "Sämre värme eller kyla",
    text: "Lägre effekt kan bero på smuts, luftflöde, inställningar, placering eller tekniskt fel. Vi hjälper dig sortera vad som är mest sannolikt.",
  },
  {
    title: "Missljud eller vibrationer",
    text: "Nya ljud, vibrationer eller konstigt beteende bör kontrolleras i tid, särskilt om pumpen används som viktig värmekälla.",
  },
];

const faqs = [
  { question: "Min värmepump visar en felkod, vad ska jag göra?", answer: "Anteckna felkoden och kontakta oss. Beskriv gärna modell, när felet uppstår och om pumpen fortfarande värmer eller kyler." },
  { question: "Hur ofta bör pumpen servas?", answer: "En luftvärmepump bör servas med 2–3 års intervall för att säkerställa god effekt." },
  { question: "Hjälper ni kunder på Hisingen, i Göteborg, Stenungsund och Lilla Edet?", answer: "Ja, vi hjälper kunder på Hisingen, i Göteborg, Stenungsund och Lilla Edet." },
  { question: "Varför värmer luftvärmepumpen sämre än tidigare?", answer: "Det kan bero på smuts, försämrat luftflöde, inställningar, placering, väderförhållanden eller tekniskt fel. Vi kan kontrollera pumpen och rekommendera nästa steg." },
  { question: "Ska jag stänga av pumpen om den låter konstigt?", answer: "Om pumpen låter ovanligt mycket, vibrerar kraftigt eller beter sig onormalt är det klokt att kontakta oss och beskriva problemet innan du fortsätter använda den hårt." }
];

const serviceSchema = {
  "@type": "Service",
  "@id": `${new URL("/felsokning-luftvarmepump", SITE.url).toString()}#service`,
  name: serviceName,
  serviceType: "Felsökning av luftvärmepump",
  description,
  provider: {
    "@id": `${SITE.url}/#business`,
  },
  areaServed: SERVICE_AREA_SCHEMA,
  url: new URL("/felsokning-luftvarmepump", SITE.url).toString(),
};
---

<BaseLayout title={title} description={description} image="/images/service-troubleshooting.png" structuredData={serviceSchema}>
  <Breadcrumbs crumbs={[{ text: "Tjänster", link: "/#tjanster" }, { text: serviceName, link: "/felsokning-luftvarmepump" }]} />

  <HeroSection 
    title={serviceName}
    description="Felsökning vid felkod, missljud, dålig värme, svag kyla eller andra driftproblem. Vi hjälper kunder på Hisingen, i Göteborg, Stenungsund och Lilla Edet vidare."
    primaryCTA={{ text: "Kontakta oss", link: "/offert" }}
    image="/images/service-troubleshooting.png"
    imageAlt="Tekniker utför felsökning på luftvärmepump"
  />

  <section class="section-padding">
    <Container>
      <div class="content-grid">
        <div class="main-content">
          <h2>När pumpen inte fungerar som den ska</h2>
          <p>Om pumpen beter sig konstigt, visar felkod eller inte ger samma effekt som tidigare ska du kontakta oss. I många fall kan service eller kontroll behövas för att säkerställa god drift.</p>
          <p>Ju tydligare du beskriver felet, desto bättre kan vi hjälpa dig vidare. Skriv gärna ner modell, felkod, när problemet började och om pumpen fortfarande värmer eller kyler.</p>
          
          <h3>Kontakta oss vid:</h3>
          <ul>
            <li>Felkod i displayen.</li>
            <li>Sämre värme eller kyla än vanligt.</li>
            <li>Konstiga ljud eller beteenden.</li>
            <li>Osäkerhet kring om pumpen behöver service.</li>
          </ul>
        </div>
      </div>
    </Container>
  </section>

  <section class="section-padding bg-light">
    <Container>
      <h2>Vanliga felsökningslägen</h2>
      <div class="needs-grid">
        {troubleshootingChecks.map((item) => (
          <article class="need-item">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </Container>
  </section>

  <section class="section-padding">
    <Container>
      <h2>Service och underhåll</h2>
      <div class="needs-grid">
        <div class="need-item">
          <h3>2–3 års intervall</h3>
          <p>En luftvärmepump bör servas med 2–3 års intervall för att säkerställa god effekt.</p>
        </div>
        <div class="need-item">
          <h3>Vid felkod</h3>
          <p>Visar pumpen felkod ska du kontakta oss så hjälper vi dig vidare.</p>
        </div>
        <div class="need-item">
          <h3>När den beter sig konstigt</h3>
          <p>Om pumpen låter eller beter sig annorlunda än vanligt är det bättre att höra av sig i tid.</p>
        </div>
      </div>
    </Container>
  </section>

  <section class="section-padding bg-light">
    <Container>
      <h2>Vi hjälper kunder i vårt område</h2>
      <p class="section-copy">Vi prioriterar felsökning och service på Hisingen, i Göteborg, Stenungsund och Lilla Edet. Läs gärna mer om respektive område om du vill se lokal information innan du skickar offertförfrågan.</p>
      <div class="areas-grid">
        {areas.map(area => (
          <AreaCard {...area} />
        ))}
      </div>
    </Container>
  </section>

  <section class="section-padding">
    <Container>
      <h2>Andra tjänster</h2>
      <div class="services-grid">
        {otherServices.map(service => (
          <ServiceCard {...service} />
        ))}
      </div>
    </Container>
  </section>

  <FAQSection faqs={faqs} />

  <CTASection 
    title="Problem med din värmepump?"
    description="Beskriv vad som händer med pumpen så hör vi av oss så snart vi har möjlighet."
    buttonText="Kontakta oss"
    buttonLink="/offert"
  />
</BaseLayout>

<style>
  .content-grid {
    display: grid;
    gap: 3rem;
  }
  .bg-light {
    background: var(--bg-subtle);
  }
  .needs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
  }
  .need-item {
    background: var(--white);
    padding: 2.5rem;
    border: 1px solid var(--border);
  }
  .need-item h3 {
    margin-bottom: 1rem;
    font-size: 1.25rem;
  }
  .need-item p,
  .section-copy {
    color: var(--text-muted);
    line-height: 1.7;
  }
  .section-copy {
    max-width: 760px;
    margin-top: 1rem;
  }
  .main-content h2, .main-content h3 {
    text-transform: none;
    letter-spacing: normal;
  }
  .main-content ul {
    margin-top: 1.5rem;
    list-style: disc;
    padding-left: 1.5rem;
  }
  .main-content li {
    margin-bottom: 0.75rem;
  }
  .areas-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
  }
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
  }
</style>
