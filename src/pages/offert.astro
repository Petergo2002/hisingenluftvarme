---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { AREA_LINKS, SITE } from '../data/site';

const title = "Kontakt & Offert";
const description = "Kontakta Hisingen Luftvärme för kostnadsfri offert, hembesök, installation eller service av luftvärmepump i Göteborg, Stenungsund och Lilla Edet.";
const contactPageSchema = {
  "@type": "ContactPage",
  name: title,
  description,
  url: new URL("/offert", SITE.url).toString(),
  mainEntity: {
    "@id": `${SITE.url}/#business`,
  },
};
---

<BaseLayout title={title} description={description} structuredData={contactPageSchema}>
  <Breadcrumbs crumbs={[{ text: title }]} />

  <section class="section-padding bg-light">
    <Container>
      <div class="page-intro">
        <div>
          <span class="eyebrow">Kontakt</span>
          <h1>Kontakta oss</h1>
          <p class="lead">Fyll i dina uppgifter så hör vi av oss så snart vi kan — oftast inom 24 timmar. Du kan också ringa eller mejla oss direkt.</p>
        </div>

        <div class="intro-points surface">
          <h2>Det här kan vi hjälpa dig med</h2>
          <ul>
            <li>Kostnadsfritt hembesök i Göteborg, Stenungsund och Lilla Edet</li>
            <li>Försäljning och installation av luftvärmepump</li>
            <li>Service och underhåll av befintlig pump</li>
          </ul>
        </div>
      </div>
    </Container>
  </section>

  <section class="section-padding">
    <Container>
      <div class="quote-layout">
        <form id="offer-form" class="surface quote-form" action="https://api.web3forms.com/submit" method="post">
          <input type="hidden" name="access_key" value="2f254e4f-d9bb-423e-96f9-be5f3d93779a" />
          <input type="hidden" name="subject" value="Ny offertförfrågan från Hisingen Luftvärme" />
          <input type="hidden" name="from_name" value="Hisingen Luftvärme" />
          <input type="checkbox" name="botcheck" class="botcheck" tabindex="-1" autocomplete="off" />

          <div class="form-grid">
            <label>
              <span>Namn</span>
              <input type="text" name="Namn" placeholder="Ditt namn" autocomplete="name" required />
            </label>
            <label>
              <span>E-post</span>
              <input type="email" name="E-post" placeholder={SITE.email} autocomplete="email" required />
            </label>
            <label>
              <span>Telefon</span>
              <input type="tel" name="Telefon" placeholder="Telefonnummer" autocomplete="tel" required />
            </label>
            <label>
              <span>Tjänst</span>
              <select name="Tjänst" required>
                <option value="">Välj tjänst</option>
                <option value="Hembesök">Hembesök</option>
                <option value="Installation">Installation</option>
                <option value="Service">Service</option>
                <option value="Underhåll">Underhåll</option>
              </select>
            </label>
            <label>
              <span>Område</span>
              <select name="Område" autocomplete="address-level2" required>
                <option value="">Välj område</option>
                {AREA_LINKS.map((area) => <option value={area.name}>{area.name}</option>)}
              </select>
            </label>
            <label class="full-width">
              <span>Vad kan vi hjälpa dig med?</span>
              <textarea name="Vad kan vi hjälpa dig med?" placeholder="Beskriv kort vad du vill ha hjälp med." required></textarea>
            </label>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn btn-primary">Skapa offertförfrågan</button>
            <p id="form-message" class="form-message" aria-live="polite"></p>
          </div>
        </form>

        <aside class="quote-sidebar">
          <div class="surface info-card">
            <h2>Kontaktuppgifter</h2>
            <p>Du kan också ringa eller mejla oss direkt.</p>
            <a href={SITE.phoneHref} class="contact-link">{SITE.phoneDisplay}</a>
            <a href={SITE.emailHref} class="contact-link">{SITE.email}</a>
            <a href={SITE.addressHref} class="contact-link">{SITE.address}</a>
          </div>

          <div class="surface info-card">
            <h2>Område</h2>
            <ul class="area-list">
              {AREA_LINKS.map((area) => <li>{area.name}</li>)}
            </ul>
          </div>
        </aside>
      </div>
    </Container>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById("offer-form");
  const submitBtn = form?.querySelector('button[type="submit"]');
  const formMessage = document.getElementById("form-message");

  const setFormMessage = (message, type = "") => {
    if (!formMessage) return;
    formMessage.textContent = message;
    formMessage.dataset.type = type;
  };

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    if (!(form instanceof HTMLFormElement) || !(submitBtn instanceof HTMLButtonElement)) {
      return;
    }

    const formData = new FormData(form);
    const originalText = submitBtn.textContent ?? "Skapa offertförfrågan";

    submitBtn.textContent = "Skickar...";
    submitBtn.disabled = true;
    setFormMessage("Skickar din förfrågan...", "loading");

    try {
      const response = await fetch(form.action, {
        method: "POST",
        body: formData,
      });

      const data = await response.json();

      if (response.ok && data.success) {
        setFormMessage("Tack! Din förfrågan har skickats. Vi återkommer så snart vi kan.", "success");
        form.reset();
      } else {
        setFormMessage(data.message ? `Fel: ${data.message}` : "Något gick fel. Kontrollera uppgifterna och försök igen.", "error");
      }
    } catch {
      setFormMessage("Något gick fel. Försök igen eller kontakta oss direkt via telefon eller e-post.", "error");
    } finally {
      submitBtn.textContent = originalText;
      submitBtn.disabled = false;
    }
  });
</script>

<style>
  .page-intro,
  .quote-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(320px, 0.9fr);
    gap: 2rem;
    align-items: start;
  }

  .lead {
    max-width: 44rem;
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .intro-points,
  .quote-form,
  .info-card {
    padding: 2rem;
  }

  .intro-points h2,
  .info-card h2 {
    font-size: 1.1rem;
    margin-bottom: 1rem;
  }

  .intro-points ul,
  .area-list {
    list-style: disc;
    padding-left: 1.2rem;
  }

  .intro-points li,
  .area-list li {
    margin-bottom: 0.75rem;
    color: var(--text-muted);
  }

  .quote-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .botcheck {
    position: absolute;
    left: -9999px;
    opacity: 0;
    pointer-events: none;
  }

  .quote-form label {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.92rem;
    font-weight: 600;
  }

  .quote-sidebar {
    display: grid;
    gap: 1rem;
  }

  .form-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }

  .form-actions .btn:disabled {
    cursor: not-allowed;
    opacity: 0.7;
  }

  .form-message {
    margin: 0;
    min-height: 1.4em;
    flex: 1 1 16rem;
    color: var(--text-muted);
    font-size: 0.92rem;
    font-weight: 700;
    line-height: 1.45;
  }

  .form-message[data-type="success"] {
    color: #187044;
  }

  .form-message[data-type="error"] {
    color: #a22b2b;
  }

  .contact-link {
    display: block;
    margin-top: 0.9rem;
    font-weight: 700;
  }

  @media (max-width: 900px) {
    .page-intro,
    .quote-layout {
      grid-template-columns: 1fr;
    }
  }
</style>
