---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTASection from '../components/CTASection.astro';
import AreaCard from '../components/AreaCard.astro';
import FAQSection from '../components/FAQSection.astro';
import { AREA_LINKS, INSTALLATION_ADDONS, INSTALLATION_INCLUDED, PRODUCTS, ROT_TERMS, SERVICE_AREA_SCHEMA, SITE } from '../data/site';

const title = "Luftvärmepump pris med installation | ROT & offert";
const description = "Se pris på luftvärmepump med standardinstallation efter ROT-avdrag. Hisingen Luftvärme hjälper på Hisingen, i Göteborg, Stenungsund och Lilla Edet.";

const priceFactors = [
  {
    title: "Pumpens kapacitet",
    text: "Boyta, planlösning, isolering och hur öppet huset är påverkar vilken modell som passar bäst. En för liten pump kan ge sämre komfort, medan en större modell inte alltid är rätt svar.",
  },
  {
    title: "Placering och rördragning",
    text: "Prisbilden påverkas av var inne- och utedel placeras, väggmaterial, rörlängd, kabeldragning, kondensvatten, höjdarbete och om markstativ eller skyddstak behövs.",
  },
  {
    title: "ROT-avdrag och tillägg",
    text: "Priserna här visas efter ROT-avdrag och inklusive standardinstallation. Eventuella tillägg förklaras i offerten innan arbetet bokas.",
  },
];

const priceFaqs = [
  {
    question: "Vad kostar en luftvärmepump med installation?",
    answer: "På denna sida visas aktuella produktpriser efter ROT-avdrag och inklusive standardinstallation. Slutpriset beror på modell, placering och om installationstillägg behövs.",
  },
  {
    question: "Ingår standardinstallation i priserna?",
    answer: "Ja, produktpriserna visas inklusive standardinstallation. På sidan listas även vad som ingår och vilka tillägg som kan bli aktuella.",
  },
  {
    question: "När behövs installationstillägg?",
    answer: "Tillägg kan behövas vid extra rördragning, markstativ, skyddstak, betonghåltagning, höjdarbete, skärgårdsläge eller bortforsling av befintlig pump.",
  },
  {
    question: "Gäller priset på Hisingen, i Göteborg, Stenungsund och Lilla Edet?",
    answer: "Ja, Hisingen Luftvärme prioriterar Hisingen, Göteborg, Stenungsund och Lilla Edet. Vi går igenom lokala förutsättningar vid hembesök eller offertförfrågan.",
  },
];

const priceGuideSchema = [
  {
    "@type": "Service",
    "@id": `${new URL("/luftvarmepump-pris", SITE.url).toString()}#service`,
    name: "Luftvärmepump pris med installation",
    serviceType: "Försäljning och installation av luftvärmepump",
    description,
    provider: {
      "@id": `${SITE.url}/#business`,
    },
    areaServed: SERVICE_AREA_SCHEMA,
    url: new URL("/luftvarmepump-pris", SITE.url).toString(),
  },
  {
    "@type": "ItemList",
    name: "Pris på luftvärmepumpar med installation",
    itemListElement: PRODUCTS.map((product, index) => ({
      "@type": "ListItem",
      position: index + 1,
      item: {
        "@type": "Product",
        name: product.name,
        description: product.specs.join(", "),
        category: "Luftvärmepump",
        image: product.image ? new URL(product.image, SITE.url).toString() : undefined,
        offers: {
          "@type": "Offer",
          price: product.price.replace(/\D/g, ""),
          priceCurrency: "SEK",
          availability: "https://schema.org/InStock",
          url: new URL("/luftvarmepump-pris", SITE.url).toString(),
          seller: {
            "@id": `${SITE.url}/#business`,
          },
        },
      },
    })),
  },
];
---

<BaseLayout title={title} description={description} image="/images/service-installation.jpg" structuredData={priceGuideSchema}>
  <Breadcrumbs crumbs={[{ text: "Priser", link: "/luftvarmepump-pris" }]} />

  <section class="section-padding bg-light">
    <Container>
      <div class="page-intro">
        <span class="eyebrow">Prisguide</span>
        <h1>Luftvärmepump pris med installation</h1>
        <p class="lead">Här ser du pris på luftvärmepumpar efter ROT-avdrag och inklusive standardinstallation. För exakt offert går vi igenom husets förutsättningar, placering och eventuella tillägg.</p>
        <div class="intro-actions">
          <a class="btn btn-primary" href="/offert">Begär offert</a>
          <a class="btn btn-secondary" href="/installation-luftvarmepump">Vad ingår i installation?</a>
        </div>
      </div>
    </Container>
  </section>

  <section class="section-padding">
    <Container>
      <div class="section-header">
        <span class="eyebrow">Priser</span>
        <h2>Aktuella modeller och pris efter ROT</h2>
        <p class="text-muted">Priserna gäller inklusive standardinstallation. Läs alltid produktblad och offert innan beslut.</p>
      </div>
      <div class="price-grid">
        {PRODUCTS.map((product) => (
          <article class="price-card">
            <div>
              <h3>{product.name}</h3>
              <p class="price">{product.price}</p>
              <p class="price-note">Efter ROT-avdrag, inklusive standardinstallation.</p>
            </div>
            <ul>
              {product.specs.slice(0, 4).map((spec) => <li>{spec}</li>)}
            </ul>
            {product.productSheet && (
              <a href={product.productSheet} target="_blank" rel="noopener noreferrer">Produktblad</a>
            )}
          </article>
        ))}
      </div>
    </Container>
  </section>

  <section class="section-padding bg-light">
    <Container>
      <div class="section-header">
        <span class="eyebrow">Prisbild</span>
        <h2>Vad påverkar kostnaden?</h2>
      </div>
      <div class="factor-grid">
        {priceFactors.map((factor) => (
          <article class="factor-card">
            <h3>{factor.title}</h3>
            <p>{factor.text}</p>
          </article>
        ))}
      </div>
    </Container>
  </section>

  <section class="section-padding">
    <Container>
      <div class="split-content">
        <div>
          <span class="eyebrow">Standardinstallation</span>
          <h2>Det här ingår normalt</h2>
          <ul class="check-list">
            {INSTALLATION_INCLUDED.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <aside class="surface summary-card">
          <h3>Möjliga tillägg</h3>
          <ul>
            {INSTALLATION_ADDONS.map((item) => <li>{item}</li>)}
          </ul>
        </aside>
      </div>
    </Container>
  </section>

  <section class="section-padding bg-light" id="rot-avdrag">
    <Container>
      <div class="split-content">
        <div>
          <span class="eyebrow">ROT-avdrag</span>
          <h2>ROT hanteras direkt på fakturan</h2>
          <p class="text-muted">Hisingen Luftvärme gör ROT-avdraget direkt på fakturan och ansöker om ersättning från Skatteverket när villkoren är uppfyllda.</p>
        </div>
        <ul class="surface summary-card">
          {ROT_TERMS.map((term) => <li>{term}</li>)}
        </ul>
      </div>
    </Container>
  </section>

  <section class="section-padding">
    <Container>
      <div class="section-header">
        <span class="eyebrow">Område</span>
        <h2>Offert på Hisingen, i Göteborg, Stenungsund och Lilla Edet</h2>
        <p class="text-muted">Välj område för mer lokal information om installation, service och felsökning.</p>
      </div>
      <div class="areas-grid">
        {AREA_LINKS.map((area) => <AreaCard {...area} />)}
      </div>
    </Container>
  </section>

  <FAQSection faqs={priceFaqs} />

  <CTASection
    title="Vill du få exakt pris?"
    description="Skicka en offertförfrågan så återkommer vi med rådgivning, prisbild och nästa steg."
    buttonText="Begär kostnadsfri offert"
    buttonLink="/offert"
  />
</BaseLayout>

<style>
  .bg-light {
    background: var(--bg-subtle);
  }
  .page-intro,
  .section-header {
    max-width: 780px;
  }
  .page-intro h1,
  .section-header h2 {
    text-transform: none;
    letter-spacing: 0;
  }
  .lead {
    color: var(--text-muted);
    font-size: 1.08rem;
    line-height: 1.7;
  }
  .intro-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
  }
  .section-header {
    margin-bottom: 2rem;
  }
  .price-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 1rem;
  }
  .price-card,
  .factor-card,
  .summary-card {
    border: 1px solid var(--border);
    background: var(--white);
  }
  .price-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
  }
  .price-card h3,
  .factor-card h3,
  .summary-card h3 {
    font-size: 1.1rem;
    margin-bottom: 0.7rem;
  }
  .price {
    color: var(--secondary-hover);
    font-size: 1.55rem;
    font-weight: 900;
    margin-bottom: 0.2rem;
  }
  .price-note,
  .text-muted,
  .factor-card p {
    color: var(--text-muted);
    line-height: 1.7;
  }
  .price-card ul,
  .check-list,
  .summary-card {
    list-style: disc;
    padding-left: 1.2rem;
  }
  .price-card li,
  .check-list li,
  .summary-card li {
    color: var(--text-muted);
    line-height: 1.55;
    margin-bottom: 0.55rem;
  }
  .price-card a {
    margin-top: auto;
    color: var(--secondary-hover);
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .factor-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .factor-card {
    padding: 2rem;
  }
  .split-content {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(320px, 0.9fr);
    gap: 2rem;
    align-items: start;
  }
  .summary-card {
    padding: 2rem;
  }
  .areas-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 1rem;
  }
  @media (max-width: 820px) {
    .factor-grid,
    .split-content {
      grid-template-columns: 1fr;
    }
    .page-intro h1 {
      font-size: clamp(2rem, 9vw, 2.8rem);
      line-height: 1.12;
    }
  }
</style>
