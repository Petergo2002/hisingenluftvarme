---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { BUSINESS_ADDRESS, SERVICE_AREA_SCHEMA, SERVICE_CATALOG, SITE } from '../data/site';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  image?: string;
  imageAlt?: string;
  type?: "website" | "article";
  noindex?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = SITE.defaultDescription,
  canonicalPath,
  image = SITE.defaultImage,
  imageAlt = "Hisingen Luftvärme installerar och servar luftvärmepumpar",
  type = "website",
  noindex = false,
  structuredData = [],
} = Astro.props;

const pageTitle = title.includes(SITE.name) ? title : `${title} | ${SITE.name}`;
const normalizePath = (path: string) => {
  const cleanPath = path.startsWith("/") ? path : `/${path}`;
  return cleanPath === "/" ? cleanPath : cleanPath.replace(/\/$/, "");
};
const absoluteUrl = (path: string) => new URL(path, SITE.url).toString();
const canonicalUrl = absoluteUrl(normalizePath(canonicalPath ?? Astro.url.pathname));
const imageUrl = absoluteUrl(image);
const robotsContent = noindex ? "noindex, follow" : "index, follow, max-image-preview:large";
const extraStructuredData = (Array.isArray(structuredData) ? structuredData : [structuredData]).filter(Boolean);
const businessId = `${SITE.url}/#business`;
const websiteId = `${SITE.url}/#website`;
const logoUrl = absoluteUrl(SITE.logo);
const serviceOfferings = SERVICE_CATALOG.map((service) => ({
  "@type": "Offer",
  itemOffered: {
    "@type": "Service",
    "@id": `${new URL(service.link, SITE.url).toString()}#service`,
    name: service.name,
    serviceType: service.serviceType,
    description: service.description,
    areaServed: SERVICE_AREA_SCHEMA,
    provider: {
      "@id": businessId,
    },
    url: new URL(service.link, SITE.url).toString(),
  },
}));
const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "HVACBusiness",
      "@id": businessId,
      name: SITE.name,
      url: absoluteUrl("/"),
      description: SITE.defaultDescription,
      slogan: SITE.brandLine,
      logo: {
        "@type": "ImageObject",
        "@id": `${SITE.url}/#logo`,
        url: logoUrl,
      },
      image: [
        absoluteUrl(SITE.defaultImage),
        absoluteUrl("/images/service-installation.jpg"),
        absoluteUrl("/images/service-maintenance.png"),
      ],
      telephone: "+46766443438",
      email: SITE.email,
      priceRange: "$$",
      address: {
        "@type": "PostalAddress",
        ...BUSINESS_ADDRESS,
      },
      hasMap: SITE.addressHref,
      areaServed: SERVICE_AREA_SCHEMA,
      knowsAbout: [
        "luftvärmepump",
        "luft-luftvärmepump",
        "installation av luftvärmepump",
        "service av luftvärmepump",
        "felsökning av luftvärmepump",
        "ROT-avdrag",
      ],
      makesOffer: serviceOfferings,
      contactPoint: {
        "@type": "ContactPoint",
        telephone: "+46766443438",
        email: SITE.email,
        contactType: "customer service",
        areaServed: SERVICE_AREA_SCHEMA,
        availableLanguage: ["sv"],
        url: absoluteUrl("/offert"),
      },
    },
    {
      "@type": "WebSite",
      "@id": websiteId,
      url: absoluteUrl("/"),
      name: SITE.name,
      description: SITE.defaultDescription,
      inLanguage: SITE.language,
      publisher: {
        "@id": businessId,
      },
    },
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: pageTitle,
      description,
      isPartOf: {
        "@id": websiteId,
      },
      about: {
        "@id": businessId,
      },
      inLanguage: SITE.language,
      primaryImageOfPage: {
        "@type": "ImageObject",
        url: imageUrl,
      },
    },
    ...extraStructuredData,
  ],
};
---

<!doctype html>
<html lang={SITE.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content={robotsContent} />
    <meta name="theme-color" content="#111111" />
    <meta name="application-name" content={SITE.name} />
    <link rel="icon" href="/favicon.ico?v=3" sizes="any" />
    <link rel="shortcut icon" href="/favicon.ico?v=3" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:secure_url" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }
</style>
